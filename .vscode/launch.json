{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Application",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "console": "integratedTerminal",
            "presentation": {
                "hidden": false,
                "group": "django",
                "order": 1
            }
        }
    ]
}
